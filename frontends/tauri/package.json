{
  "name": "conn-desktop",
  "private": true,
  "version": "0.8.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --threshold error && vite build",
    "tauri": "node scripts/tauri.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test": "node tests/timeline/events.test.ts && node tests/icon/state.test.ts && node tests/connections/status.test.ts && node tests/terminal/input.test.ts && node tests/collaboration/state.test.ts",
    "test:collaboration": "node scripts/collaboration-test.mjs",
    "test:collaboration:harness": "node scripts/collaboration-harness-test.mjs",
    "test:context:harness": "node scripts/context-harness-test.mjs",
    "test:input:harness": "node scripts/input-review-harness-test.mjs",
    "test:screen": "node scripts/screen-parity-test.mjs"
  },
  "dependencies": {
    "@conn/brand": "*",
    "@conn/themes": "*",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5.0.8",
    "playwright": "1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
